{
  "@context": [
    "https://www.w3.org/2018/credentials/v1",
    "https://tharsikan-govtech.github.io/erl-config/contexts/erl.json",
    "https://w3id.org/security/suites/ed25519-2020/v1"
  ],
  "issuer": "${_issuer}",
  "type": ["VerifiableCredential", "RevenueLicenceCredential"],
  "issuanceDate": "${validFrom}",
  "expirationDate": "${expiryDate}T23:59:59.000Z",
  "credentialSubject": {
    "id": "${holderDid}",
    "licenceNumber": "${licenceNumber}",
    "receiptNumber": "${receiptNumber}",
    "issuingAuthority": "${issuingAuthority}",
    "issueDate": "${issueDate}",
    "expiryDate": "${expiryDate}",
    "feePaidLkr": ${feePaidLkr},
    "vehicleNumber": "${vehicleNumber}",
    "chassisNumber": "${chassisNumber}",
    "engineNumber": "${engineNumber}",
    "vehicleClass": "${vehicleClass}",
    "make": "${make}",
    "model": "${model}",
    "yearOfManufacture": ${yearOfManufacture},
    "fuelType": "${fuelType}",
    "engineCapacityCc": ${engineCapacityCc},
    "colour": "${colour}",
    "province": "${province}"
  }
}
