{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "RevenueLicenceCredential": {
      "@id": "https://tharsikan-govtech.github.io/erl-config/vocab#RevenueLicenceCredential"
    },

    "erl": "https://tharsikan-govtech.github.io/erl-config/vocab#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "licenceNumber": "erl:licenceNumber",
    "receiptNumber": "erl:receiptNumber",
    "issuingAuthority": "erl:issuingAuthority",
    "issueDate": { "@id": "erl:issueDate", "@type": "xsd:date" },
    "expiryDate": { "@id": "erl:expiryDate", "@type": "xsd:date" },
    "feePaidLkr": { "@id": "erl:feePaidLkr", "@type": "xsd:decimal" },

    "vehicleNumber": "erl:vehicleNumber",
    "chassisNumber": "erl:chassisNumber",
    "engineNumber": "erl:engineNumber",
    "vehicleClass": "erl:vehicleClass",
    "make": "erl:make",
    "model": "erl:model",
    "yearOfManufacture": { "@id": "erl:yearOfManufacture", "@type": "xsd:integer" },
    "fuelType": "erl:fuelType",
    "engineCapacityCc": { "@id": "erl:engineCapacityCc", "@type": "xsd:integer" },
